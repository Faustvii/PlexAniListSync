<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Private [GqlSelection] backing fields are populated by the STJ resolver via reflection. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <!--
    Vendored & trimmed fork of AniListNet (github.com/dentolos19/anilistnet, archived) with
    ideas from the Kavita.AniListNet fork (github.com/Kareadita/anilistnet). Migrated to
    System.Text.Json and reduced to only the operations this app uses. See NOTICE for credits.
    Uses the in-box System.Text.Json - no package references.
  -->

</Project>
